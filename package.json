{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "test": "tsx --test src/**/*.test.ts",
    "lint": "tsc --noEmit",
    "cap:sync": "npx cap sync android",
